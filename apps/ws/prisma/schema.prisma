generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Annotation {
  id        String   @id
  roomId    String
  userId    String
  shapeId   String?
  data      Json
  createdAt DateTime @default(now())
  Room      Room     @relation(fields: [roomId], references: [id])
  User      User     @relation(fields: [userId], references: [id])
}

model Chat {
  id        String   @id
  message   String
  roomId    String
  userId    String
  createdAt DateTime @default(now())
  Room      Room     @relation(fields: [roomId], references: [id])
  User      User     @relation(fields: [userId], references: [id])
}

model Quiz {
  id         String       @id
  roomId     String
  question   String?
  imageUrl   String?
  isOpen     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  Room       Room         @relation(fields: [roomId], references: [id])
  QuizAnswer QuizAnswer[]
}

model QuizAnswer {
  id        String   @id
  quizId    String
  userId    String
  imageUrl  String?
  text      String?
  createdAt DateTime @default(now())
  Quiz      Quiz     @relation(fields: [quizId], references: [id])
  User      User     @relation(fields: [userId], references: [id])
}

model Room {
  id         String       @id
  slug       String       @unique
  createdAt  DateTime     @default(now())
  adminId    String
  expiresAt  DateTime?
  isLocked   Boolean      @default(false)
  isPublic   Boolean      @default(false)
  thumbnail  String?
  updatedAt  DateTime
  Annotation Annotation[]
  Chat       Chat[]
  Quiz       Quiz[]
  User       User         @relation(fields: [adminId], references: [id])
  RoomMember RoomMember[]
  Session    Session[]
  Shape      Shape[]
}

model RoomMember {
  id       String   @id
  userId   String
  roomId   String
  canDraw  Boolean  @default(true)
  joinedAt DateTime @default(now())
  role     Role     @default(STUDENT)
  Room     Room     @relation(fields: [roomId], references: [id])
  User     User     @relation(fields: [userId], references: [id])

  @@unique([userId, roomId])
}

model Session {
  id           String         @id
  roomId       String
  startedAt    DateTime       @default(now())
  endedAt      DateTime?
  Room         Room           @relation(fields: [roomId], references: [id])
  SessionEvent SessionEvent[]
}

model SessionEvent {
  id        String   @id
  sessionId String
  userId    String
  type      String
  payload   Json
  timestamp DateTime @default(now())
  Session   Session  @relation(fields: [sessionId], references: [id])
}

model Shape {
  id         String    @id
  roomId     String
  userId     String
  type       ShapeType
  x1         Float
  y1         Float
  x2         Float
  y2         Float
  radius     Float?
  points     Json?
  color      String    @default("#000000")
  width      Float     @default(2)
  text       String?
  fontFamily String?
  imageUrl   String?
  layer      Layer     @default(STUDENT)
  sequence   Int
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  Room       Room      @relation(fields: [roomId], references: [id])
  User       User      @relation(fields: [userId], references: [id])
}

model User {
  id         String       @id
  email      String       @unique
  password   String
  name       String
  photo      String?
  Annotation Annotation[]
  Chat       Chat[]
  QuizAnswer QuizAnswer[]
  Room       Room[]
  RoomMember RoomMember[]
  Shape      Shape[]
}

enum Layer {
  STUDENT
  TEACHER
}

enum Role {
  TEACHER
  STUDENT
  GUEST
}

enum ShapeType {
  RECTANGLE
  CIRCLE
  LINE
  FREEHAND
  TEXT
  IMAGE
  ARROW
}
